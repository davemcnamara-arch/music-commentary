{
  "manifest_version": 3,
  "name": "Music Commentary Extension",
  "version": "1.0.0",
  "description": "Analyze YouTube music videos and provide timestamped educational commentary",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.youtube.com/*"
  ],
  "action": {
    "default_title": "Music Commentary",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "192": "icons/icon192.png",
      "512": "icons/icon512.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "192": "icons/icon192.png",
    "512": "icons/icon512.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popout.html", "popout.css", "popout.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
